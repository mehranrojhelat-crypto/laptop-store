generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Laptop {
  id          String   @id
  name        String
  brand       String
  category    String
  price       Int
  oldPrice    Int?
  image       String
  rating      Float
  reviews     Int
  inStock     Boolean  @default(true)
  badge       String?
  cpu         String
  ram         Int
  storage     Int
  gpu         String
  screen      Float
  os          String
  weight      String
  battery     String
  description String
  highlights  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviewList  Review[]
}

model Review {
  id         String   @id @default(cuid())
  laptopId   String
  laptop     Laptop   @relation(fields: [laptopId], references: [id], onDelete: Cascade)

  authorName String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  editToken  String

  @@index([laptopId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
