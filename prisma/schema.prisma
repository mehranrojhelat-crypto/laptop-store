generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Laptop {
  id          String   @id
  name        String
  brand       String
  category    String
  price       Int
  oldPrice    Int?
  image       String
  rating      Float
  reviews     Int
  inStock     Boolean  @default(true)
  badge       String?
  cpu         String
  ram         Int
  storage     Int
  gpu         String
  screen      Float
  os          String
  weight      String
  battery     String
  description String
  highlights  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviewList  Review[]   // ← اضافه شد
}

model Review {
  id        String   @id @default(cuid())
  laptopId  String
  laptop    Laptop   @relation(fields: [laptopId], references: [id], onDelete: Cascade)

  authorName String
  rating     Int      // 1 تا 5
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // برای ویرایش: یک توکن ساده که موقع ثبت نظر به کاربر می‌دیم
  editToken  String

  @@index([laptopId])
}
