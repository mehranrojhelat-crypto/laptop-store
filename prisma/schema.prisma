generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Laptop {
  id          String   @id
  name        String
  brand       String
  category    String
  price       Int
  oldPrice    Int?
  image       String
  images      String   @default("[]")
  rating      Float
  reviews     Int
  inStock     Boolean  @default(true)
  badge       String?
  cpu         String
  ram         Int
  storage     Int
  gpu         String
  screen      Float
  os          String
  weight      String
  battery     String
  description String
  highlights  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviewList  Review[]
  orderItems  OrderItem[]
}

model Review {
  id         String   @id @default(cuid())
  laptopId   String
  laptop     Laptop   @relation(fields: [laptopId], references: [id], onDelete: Cascade)

  authorName String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  editToken  String

  @@index([laptopId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id            String   @id @default(cuid())

  trackingCode  String   @unique

  firstName     String
  lastName      String
  phone         String
  city          String
  address       String
  postalCode    String

  paymentMethod String
  status        String   @default("PENDING")

  subtotal      Int
  shipping      Int
  total         Int

  userId        String?
  userEmail     String?
  userName      String?

  note          String?

  items         OrderItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([trackingCode])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  laptopId   String
  laptop     Laptop @relation(fields: [laptopId], references: [id])

  name       String
  brand      String
  image      String
  price      Int
  quantity   Int

  @@index([orderId])
  @@index([laptopId])
}
